#!/usr/bin/env bash
# zot-pipeline — new paper in Zotero → deployed snapshot, unattended, on mbp.
#
# This is an OPERATE-PLANE runner. It shells `sci` (which holds the Zotero
# and OpenAlex credentials) and `zot` (which holds none), and it meets them
# where they already meet: at files in ~/.local/share/zot/staging. It is a
# script and not a zot subcommand for exactly that reason — a network call
# or a credential inside the read binary is a design error, and zot is
# deployed to an internet-facing VM.
#
# Two cadences, because extraction is minutes per paper and an item-plane
# refresh is about two:
#
#   fast   a new item appears  →  export → build → ship   (~2 min)
#          the paper is searchable at `metadata` depth
#   slow   PDFs + extraction   →  parse-tei/parse-docling → export → build
#          → ship;  the paper moves to `full` depth
#
# Both take the same lock. Staging has no torn-write protection, so two
# runners writing it at once is undefined.
#
# Usage
#   zot-pipeline poll        launchd's fast entry: read the Zotero version
#                            counter, debounce, fire the fast cadence
#   zot-pipeline fast        run the fast cadence now (skips the debounce)
#   zot-pipeline slow        launchd's slow entry: acquire + extract + parse,
#                            then the fast cadence's tail
#   zot-pipeline preflight   check every prerequisite; nonzero if any is missing
#   zot-pipeline status      print the last run's outcome
#
# Flags (before or after the verb)
#   --dry-run        print every command that would run; run none of them
#   --once           fire regardless of the debounce (poll only)
#   --no-ship        build but do not rsync to the VM
#   --no-openalex    never run the metered stage, whatever the leash says
#   --no-extract     slow cadence only: skip PDF acquisition and extraction
#   --verbose        echo each command as it runs
#
# Supervised first run (before the launchd jobs are ever loaded):
#   zot-pipeline preflight
#   zot-pipeline --dry-run fast
#   zot-pipeline --once --no-ship --no-openalex fast

# NOT set -E, deliberately. The gates SIGNAL with an exit status — a hot
# journal, a dirty WAL and a lagging mirror are all "return 1" — and every
# one of them is read through a command substitution. With -E the ERR trap
# is inherited into that subshell, where bash cannot see that the caller
# already handles the failure with `|| rc=$?`; the trap fired, recorded
# "unexpected error on line 384", and its own notification text was
# captured into the variable holding the gate's verdict. An expected answer
# must never be reported as a crash. Unexpected failures are caught by the
# EXIT trap instead, which cannot misfire inside a subshell.
set -euo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly SELF_DIR
# shellcheck source=./pipeline-lib.sh
source "$SELF_DIR/pipeline-lib.sh"

# ---------------------------------------------------------------------------
# Configuration — defaults here, overridden by the config file, then by env.
# ---------------------------------------------------------------------------

CONFIG_FILE=${ZOT_PIPELINE_CONFIG:-$HOME/.config/zot-pipeline/config.env}

: "${ZOT_ARTIFACTS:=$HOME/.local/share/zot}"
: "${ZOT_STAGING:=$ZOT_ARTIFACTS/staging}"
: "${STATE_DIR:=$HOME/.local/state/zot-pipeline}"

: "${SCI_CONFIG:=$HOME/.config/sci/zot.json}"
: "${LIBRARY:=all}"

: "${DEBOUNCE_SECONDS:=300}"     # quiet period after the last counter move
: "${GATE_ATTEMPTS:=5}"          # export retries when a freshness gate holds
: "${GATE_WAIT_SECONDS:=30}"     # sleep between those attempts
: "${WAL_TOLERANCE_BYTES:=0}"    # nonzero pending WAL is never acceptable

: "${OA_REQUEST_CAP:=50}"        # hard ceiling on OpenAlex requests per run

: "${SHIP_HOST:=obsmcp.exe.xyz}"
: "${SHIP_PATH:=.local/share/zot/}"

: "${TEI_DIR:=$HOME/syncthing/air-mbp/zen-data/sources/grobid-tei}"
: "${EXTRACT_DIR:=$HOME/syncthing/air-mbp/neurotree-scrape/docling-extracts}"
: "${GROBID_PILOT:=$HOME/syncthing/air-mbp/grobid/pilot}"
: "${GROBID_URL:=http://localhost:8070}"
: "${GROBID_WORKERS:=16}"
: "${PDF_SOURCE:=missing-pdf}"   # collection or saved search `doctor pdfs` scans
: "${PDF_LIBRARY:=personal}"     # doctor pdfs is a single-library verb

# shellcheck source=/dev/null
[[ -r $CONFIG_FILE ]] && source "$CONFIG_FILE"

readonly INCOMING="$ZOT_STAGING/.incoming"
readonly LOCK_DIR="$STATE_DIR/lock"
readonly STATE_FILE="$STATE_DIR/state.json"
readonly FAIL_MARKER="$STATE_DIR/FAILED"
readonly LOG_DIR="$STATE_DIR/logs"
readonly PDF_INBOX="$STATE_DIR/pdf-inbox"

# ---------------------------------------------------------------------------
# Flags
# ---------------------------------------------------------------------------

DRY_RUN=0 FORCE_ONCE=0 DO_SHIP=1 DO_OPENALEX=1 DO_EXTRACT=1 VERBOSE=0
VERB=""

while (($#)); do
    case $1 in
    --dry-run) DRY_RUN=1 ;;
    --once) FORCE_ONCE=1 ;;
    --no-ship) DO_SHIP=0 ;;
    --no-openalex) DO_OPENALEX=0 ;;
    --no-extract) DO_EXTRACT=0 ;;
    --verbose | -v) VERBOSE=1 ;;
    -h | --help)
        sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    poll | fast | slow | preflight | status) VERB=$1 ;;
    *)
        printf 'zot-pipeline: unknown argument %q\n' "$1" >&2
        exit 64
        ;;
    esac
    shift
done
VERB=${VERB:-poll}

# ---------------------------------------------------------------------------
# Logging, state, and the failure surface
# ---------------------------------------------------------------------------

log() { printf '%s  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die() {
    log "FATAL $*"
    exit 1
}

# run — the single choke point for every side effect. --dry-run prints and
# returns 0; nothing else in this file may call an external mutator directly.
run() {
    if ((DRY_RUN)); then
        printf '    would run: %s\n' "$*"
        return 0
    fi
    ((VERBOSE)) && printf '    + %s\n' "$*"
    "$@"
}

# notify — the failure surface that does not require reading a log.
#
# Three layers, cheapest first: a marker file whose existence is the alarm,
# a line in state.json that `zot-pipeline status` renders, and a macOS user
# notification. The notification is best-effort — a launchd agent in the
# Aqua session can post one, but a run over ssh cannot, and a pipeline must
# not fail because its alarm failed.
notify() {
    local title=$1 message=$2
    ((DRY_RUN)) && {
        printf '    would notify: %s — %s\n' "$title" "$message"
        return 0
    }
    osascript -e "display notification \"${message//\"/\'}\" with title \"${title//\"/\'}\"" \
        >/dev/null 2>&1 || true
}

state_get() { pl_json "$STATE_FILE" "$1" "${2:-}"; }

# state_set applies a jq expression to state.json and writes it back
# atomically. State is small and read by a human; correctness beats speed.
state_set() {
    ((DRY_RUN)) && return 0
    mkdir -p "$STATE_DIR"
    [[ -r $STATE_FILE ]] || printf '{}\n' >"$STATE_FILE"
    local tmp="$STATE_FILE.tmp.$$"
    jq "$@" <"$STATE_FILE" >"$tmp" && mv "$tmp" "$STATE_FILE"
}

# record_outcome is called exactly once per run, on every exit path.
#
# Three statuses, and the difference is whether anyone should look:
#   ok      the cadence completed
#   held    a freshness gate said "not yet" — expected, self-correcting,
#           and it deliberately leaves the counter unconsumed so the next
#           poll retries. Not an alarm until it repeats.
#   failed  something broke.
OUTCOME_RECORDED=0

record_outcome() {
    local status=$1 stage=$2 reason=$3
    OUTCOME_RECORDED=1
    state_set \
        --arg s "$status" --arg st "$stage" --arg r "$reason" \
        --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg c "$VERB" \
        '.last_run = {status:$s, cadence:$c, stage:$st, reason:$r, at:$at}'
    case $status in
    ok)
        ((DRY_RUN)) || rm -f "$FAIL_MARKER"
        ;;
    held) ;; # deliberately no marker and no notification: see hold_run
    *)
        ((DRY_RUN)) || {
            mkdir -p "$STATE_DIR"
            printf '%s  %s cadence failed at stage %s: %s\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$VERB" "$stage" "$reason" >"$FAIL_MARKER"
        }
        notify "zot pipeline: $VERB failed" "$stage — $reason"
        ;;
    esac
}

fail_stage() {
    local stage=$1 reason=$2
    log "STOP  stage=$stage reason=$reason"
    record_outcome failed "$stage" "$reason"
    exit 1
}

# hold_run — a freshness gate said "not yet", and that is an ANSWER.
#
# It exits 0: the run did not break, it declined, and launchd should see a
# clean exit. It does not consume the counter, so the next poll retries the
# whole thing. And it does not raise the alarm on the first occurrence,
# because a Zotero desktop mid-sync produces exactly this and resolves
# itself in one poll interval. A hold that KEEPS happening is a different
# animal, so consecutive holds are counted and the third one notifies.
hold_run() {
    local stage=$1 gate=$2 detail=$3
    local n
    n=$(state_get '.consecutive_holds' 0)
    [[ $n =~ ^[0-9]+$ ]] || n=0
    n=$((n + 1))

    log "HOLD  stage=$stage gate=$gate detail=$detail (consecutive: $n)"
    state_set --arg g "$gate" --arg d "$detail" --arg st "$stage" \
        --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson n "$n" \
        '.last_gate_hold = {gate:$g, detail:$d, stage:$st, at:$at} | .consecutive_holds = $n'
    record_outcome held "$stage" "gate $gate: $detail"
    ((n < 3)) || notify "zot pipeline: $VERB held ${n}x" "gate $gate — $detail"
    exit 0
}

# ---------------------------------------------------------------------------
# The lock — one runner at a time, across both cadences
# ---------------------------------------------------------------------------
#
# mkdir is atomic on every filesystem this will ever run on, which flock on
# macOS is not (no flock(1) in the base system). The pid inside lets a run
# distinguish a live holder from one that was killed.

# The lock is released by the single EXIT trap (on_exit), not by one of its
# own. Two EXIT traps cannot coexist in bash — the second silently replaces
# the first — and the version of this script that set one here quietly
# disarmed the outcome recorder for every run that took the lock, which is
# every run that does any work.
LOCK_HELD=0

acquire_lock() {
    ((DRY_RUN)) && return 0
    mkdir -p "$STATE_DIR"
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        LOCK_HELD=1
        printf '%s\n' "$$" >"$LOCK_DIR/pid"
        return 0
    fi
    local holder
    holder=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    if [[ -n $holder ]] && kill -0 "$holder" 2>/dev/null; then
        log "lock held by pid $holder — another run is in flight; exiting"
        exit 0
    fi
    log "stale lock (pid ${holder:-unknown} is gone) — reclaiming"
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" || die "cannot create lock at $LOCK_DIR"
    LOCK_HELD=1
    printf '%s\n' "$$" >"$LOCK_DIR/pid"
}

# ---------------------------------------------------------------------------
# Tool resolution
# ---------------------------------------------------------------------------
#
# `zot` is deliberately NOT required to be on PATH. The binary is built in
# the synced zotero-mcp checkout, which means it is already on mbp without
# anyone installing anything there — and this runner changes nothing on
# that host beyond dropping in a launchd plist.

resolve_tools() {
    SCI_BIN=${SCI_BIN:-$(command -v sci || true)}
    ZOT_BIN=${ZOT_BIN:-$(command -v zot || true)}
    if [[ -z ${ZOT_BIN:-} ]]; then
        for c in "$HOME/.local/bin/zot" "$HOME/syncthing/air-mbp/zotero-mcp/zot"; do
            [[ -x $c ]] && {
                ZOT_BIN=$c
                break
            }
        done
    fi
}

# ---------------------------------------------------------------------------
# Detection — the Zotero Web API version counter
# ---------------------------------------------------------------------------
#
# The counter, never the file mtime. mtime fires on opening a PDF or adding
# an annotation; the counter moves only when the library actually changes.
# One request per library, and `If-Modified-Since-Version` makes the
# no-change case a 304.
#
# Both libraries are polled because the corpus spans both: the personal
# library and the sciminds group. Either moving is a reason to rebuild.

remote_versions() {
    local key user group
    key=$(pl_json "$SCI_CONFIG" '.api_key' '')
    user=$(pl_json "$SCI_CONFIG" '.user_id' '')
    group=$(pl_json "$SCI_CONFIG" '.shared_group_id' '')
    [[ -n $key && -n $user ]] || {
        log "cannot read Zotero credentials from $SCI_CONFIG"
        return 1
    }

    local out=""
    for scope in "users/$user" ${group:+"groups/$group"}; do
        local v
        v=$(curl -fsS -m 30 -D- -o /dev/null \
            -H "Zotero-API-Version: 3" -H "Zotero-API-Key: $key" \
            "https://api.zotero.org/$scope/items?format=versions&limit=1" 2>/dev/null |
            tr -d '\r' | awk 'tolower($1)=="last-modified-version:"{print $2}') || return 1
        [[ -n $v ]] || return 1
        out+="${out:+,}$scope=$v"
    done
    printf '%s\n' "$out"
}

# The single number the freshness gate compares against: the highest
# version any polled library reports.
max_remote_version() {
    printf '%s\n' "${1//,/$'\n'}" | awk -F= '{if ($2+0 > m) m = $2+0} END {print m+0}'
}

# ---------------------------------------------------------------------------
# The freshness gates
# ---------------------------------------------------------------------------
#
# Three checks, because the ONE silent failure in this chain is a dump that
# parses, counts right, and is missing the papers you added this morning.
# Each gate names itself when it holds, so the run says which check stopped
# it rather than reporting a generic wait.
#
#   wal       `pending_wal_bytes` from the sidecar. Authoritative when
#             zotero.sqlite is in WAL mode. NOTE: mbp's Zotero is in
#             rollback-journal mode (header byte 18 = 1), so PendingWAL
#             makes no claim there and this gate reads clean. It is kept
#             because air's Zotero IS in WAL mode (byte 18 = 2) and because
#             a Zotero upgrade can flip the mode under us without warning.
#   journal   a hot `zotero.sqlite-journal` beside the database. An
#             immutable=1 reader skips journal playback exactly as it skips
#             WAL replay, so a hot journal is the rollback-mode shape of the
#             same invisible gap.
#   sync      the local mirror has actually caught up to the counter we
#             polled. This is the gate that matters on mbp: the counter says
#             the CLOUD moved, and nothing about the desktop having pulled
#             it yet. Without this, the fast path would faithfully rebuild
#             from a mirror that predates the paper that triggered it.

zotero_data_dir() { pl_json "$SCI_CONFIG" '.data_dir' ''; }

journal_gate() {
    local dir
    dir=$(zotero_data_dir)
    [[ -n $dir ]] || {
        printf 'no-data-dir 0\n'
        return 0
    }
    pl_journal_verdict "$dir/zotero.sqlite-journal"
}

# sync_gate <dump-body> <dump-meta> <observed-remote-version> <first-seen-epoch>
#
# Fresh when the dump carries an item at or beyond the version the cloud
# reported. When the change was a DELETION or a collection edit, no item can
# carry it — so a completed Zotero sync after we first saw the counter move
# is accepted as the second, weaker proof.
sync_gate() {
    local body=$1 meta=$2 want=$3 first_seen=$4
    local have last_sync last_sync_epoch

    have=$(jq -r 'select(.kind=="item") | .version // 0' <"$body" 2>/dev/null |
        awk '{if ($1+0 > m) m = $1+0} END {print m+0}')
    [[ $have =~ ^[0-9]+$ ]] || have=0

    if [[ $want =~ ^[0-9]+$ ]] && ((want > 0)) && ((have >= want)); then
        printf 'fresh item_version=%s>=%s\n' "$have" "$want"
        return 0
    fi

    last_sync=$(pl_json "$meta" '.last_sync' '')
    if [[ -n $last_sync && $first_seen =~ ^[0-9]+$ ]]; then
        last_sync_epoch=$(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$last_sync" '+%s' 2>/dev/null ||
            date -d "$last_sync" '+%s' 2>/dev/null || echo 0)
        if ((last_sync_epoch >= first_seen)); then
            printf 'fresh last_sync=%s>=first_seen\n' "$last_sync"
            return 0
        fi
    fi
    printf 'stale item_version=%s<%s last_sync=%s\n' "$have" "${want:-?}" "${last_sync:-none}"
    return 1
}

# ---------------------------------------------------------------------------
# Stage: export, gated
# ---------------------------------------------------------------------------
#
# The dump lands in staging/.incoming first and is promoted only once every
# gate passes. Nothing writes over a good staged input to find out whether
# the new one is usable — a rejected dump must leave the last good one
# exactly where it was, byte for byte.
#
# Body first, sidecar last: `internal/stage` treats a body without a
# sidecar as an unfinished producer, so promoting in the other order would
# make an intact dump look truncated for the width of one rename.

stage_export() {
    local want_version=$1 first_seen=$2
    local body="$INCOMING/zotero-items.ndjson"
    local meta="$body.meta.json"

    run mkdir -p "$INCOMING"

    # --dry-run is a PREVIEW, not a rehearsal. Two of the three gates read
    # a dump that does not exist yet, so evaluating them here could only
    # produce a verdict about nothing. The journal gate is the one that can
    # be read against the live library without exporting, so it is shown —
    # labelled, and with no power to hold, record, or notify.
    if ((DRY_RUN)); then
        printf '    would run: rm -f %s %s\n' "$body" "$meta"
        printf '    would run: %s zot --library %s export --format ndjson --out %s\n' \
            "$SCI_BIN" "$LIBRARY" "$body"
        printf '    gates (preview only, none can hold a dry run):\n'
        printf '      journal: %s   [read live, now]\n' "$(journal_gate || true)"
        printf '      wal:     needs the dump this run would not take\n'
        printf '      sync:    needs the dump this run would not take\n'
        printf '    would promote into %s only if all three passed\n' "$ZOT_STAGING"
        return 0
    fi

    local attempt gate="" detail=""
    for ((attempt = 1; attempt <= GATE_ATTEMPTS; attempt++)); do
        log "export attempt $attempt/$GATE_ATTEMPTS"

        local jv jrc=0
        jv=$(journal_gate) || jrc=$?
        if ((jrc)); then
            gate=journal detail=$jv
            log "  gate journal: HELD ($jv) — SQLite would roll this journal back, and an immutable reader cannot see it"
            sleep "$GATE_WAIT_SECONDS"
            continue
        fi
        log "  gate journal: $jv"

        run rm -f "$body" "$meta"
        if ! run "$SCI_BIN" zot --library "$LIBRARY" export --format ndjson --out "$body"; then
            fail_stage export "sci zot export failed"
        fi

        local verdict wrc=0
        verdict=$(pl_wal_verdict "$meta" "$WAL_TOLERANCE_BYTES") || wrc=$?
        case $wrc in
        0) log "  gate wal: $verdict" ;;
        1)
            gate=wal detail=$verdict
            log "  gate wal: HELD ($verdict) — the dump cannot see what Zotero has committed"
            rm -f "$body" "$meta"
            sleep "$GATE_WAIT_SECONDS"
            continue
            ;;
        *) fail_stage export "dump sidecar is $verdict — the export did not finish" ;;
        esac

        local sv src=0
        sv=$(sync_gate "$body" "$meta" "$want_version" "$first_seen") || src=$?
        if ((src == 0)); then
            log "  gate sync: $sv"
            log "promoting dump into staging"
            run mv -f "$body" "$ZOT_STAGING/zotero-items.ndjson"
            run mv -f "$meta" "$ZOT_STAGING/zotero-items.ndjson.meta.json"
            state_set '.consecutive_holds = 0'
            return 0
        fi
        gate=sync detail=$sv
        log "  gate sync: HELD ($sv) — the desktop has not pulled the change yet"
        rm -f "$body" "$meta"
        sleep "$GATE_WAIT_SECONDS"
    done

    hold_run export "${gate:-unknown}" "${detail:-held after $GATE_ATTEMPTS attempts}"
}

# ---------------------------------------------------------------------------
# Stage: the metered one
# ---------------------------------------------------------------------------
#
# `sci zot openalex sync` re-fetches the whole library and then expands
# every work's referenced_works, so it has no small mode: its own sidecars
# measure the last run at ~4,200 requests. Two independent questions decide
# whether it runs, and both must say yes.
#
#   is it WORTH running   did the delta introduce a DOI the works cache
#                         does not already hold?
#   is it ALLOWED to      does the MEASURED cost of the command fit inside
#                         the cap someone chose?
#
# Under the default cap of 50 the answer to the second is no, every time,
# and the run says so. That is the intended behaviour, not a bug to route
# around: the fast path still lands the paper at `metadata` depth, and
# resolving it to an OpenAlex work waits for a human to spend the money.

# count_new_dois — DOIs the DELTA introduced that the works cache does not
# already hold.
#
# The delta part is load-bearing. A plain "which DOIs are missing from the
# cache" answer never reaches zero: OpenAlex 404s on monographs and
# preprints, so ~40 DOIs in this library are permanently unresolvable and
# would keep claiming there is new work to do forever. Restricting the
# question to items MODIFIED SINCE the cache was produced makes it a delta
# again — the same reason the runner watches a version counter and not a
# file's mtime.
count_new_dois() {
    local items="$ZOT_STAGING/zotero-items.ndjson"
    local works="$ZOT_STAGING/openalex-works.ndjson"
    [[ -r $items ]] || {
        printf '0\n'
        return
    }
    local since
    since=$(pl_json "$ZOT_STAGING/openalex-works.ndjson.meta.json" '.produced_at' '')

    local mine
    mine=$(jq -r --arg since "$since" '
        select(.kind=="item")
        | select($since == "" or ((.date_modified // "") > $since))
        | .fields.DOI // empty
        | ascii_downcase | sub("^https?://(dx\\.)?doi\\.org/";"")' <"$items" | sort -u)

    if [[ ! -r $works ]]; then
        # No cache at all: every DOI in the library is unresolved.
        printf '%s' "$mine" | grep -c . || true
        return
    fi
    # An anti-join, not `NOT IN`: the DOI pool has nulls, and a NULL-bearing
    # NOT IN silently returns nothing. comm(1) over two sorted sets is the
    # shell's anti-join.
    comm -23 <(printf '%s\n' "$mine") \
        <(jq -r '.doi // empty | ascii_downcase | sub("^https?://(dx\\.)?doi\\.org/";"")' <"$works" | sort -u) |
        grep -c . || true
}

stage_openalex() {
    if ((!DO_OPENALEX)); then
        log "openalex: disabled by --no-openalex"
        state_set '.openalex = {decision:"skip:flag", at:(now|todate)}'
        return 0
    fi

    local new estimate decision
    new=$(count_new_dois)
    estimate=$(pl_oa_estimate \
        "$ZOT_STAGING/openalex-works.ndjson.meta.json" \
        "$ZOT_STAGING/openalex-titles.ndjson.meta.json" || true)
    decision=$(pl_oa_decision "$new" "$estimate" "$OA_REQUEST_CAP")

    log "openalex: new_dois=$new estimated_requests=$estimate cap=$OA_REQUEST_CAP → $decision"
    state_set --arg d "$decision" --argjson n "${new:-0}" \
        --arg e "$estimate" --argjson c "$OA_REQUEST_CAP" \
        '.openalex = {decision:$d, new_dois:$n, estimated_requests:$e, cap:$c, at:(now|todate)}'

    case $decision in
    run)
        run "$SCI_BIN" zot --library "$LIBRARY" openalex sync --out "$ZOT_STAGING" ||
            fail_stage openalex "sci zot openalex sync failed"
        ;;
    defer:*)
        local n
        n=$(state_get '.openalex_deferrals' 0)
        [[ $n =~ ^[0-9]+$ ]] || n=0
        state_set --argjson n "$((n + 1))" '.openalex_deferrals = $n'
        log "openalex: DEFERRED ($decision) — $new unresolved DOI(s) wait for a run someone authorises"
        if (((n + 1) % 10 == 0)); then
            notify "zot pipeline: OpenAlex deferred ${n} times" \
                "$new unresolved DOIs; est. $estimate requests > cap $OA_REQUEST_CAP"
        fi
        ;;
    esac
}

# ---------------------------------------------------------------------------
# Stage: build and ship
# ---------------------------------------------------------------------------
#
# `zot build` writes <target>.building and renames, so a killed build
# leaves the previous snapshot byte-identical and a reader mid-query keeps
# the file it opened. The ship inherits that property from rsync's own
# temp-file-then-rename — which is why --inplace must never appear here.
#
# The whole artifact directory ships as a unit, minus the builder-local
# parts. A sidecar file that lands beside the snapshot tomorrow ships with
# it and no one edits this function.

# --db is passed EXPLICITLY, never left to zot's default.
#
# Staging and the snapshot it builds are one artifact set, and a run that
# redirects only one of them is a run that reads sandbox inputs and writes
# the production output. That is not hypothetical: a test pointing
# ZOT_STAGING at a scratch directory rebuilt this machine's real 2.1 GB
# snapshot from a staging dir holding nothing but zotero-items, and turned
# it into a 42 MB item plane with no text, no works and no citations. The
# build's atomic rename did exactly its job — the previous snapshot was
# replaced completely and successfully.
stage_build() {
    run "$ZOT_BIN" build --staging "$ZOT_STAGING" --db "$ZOT_ARTIFACTS/zot.duckdb" ||
        fail_stage build "zot build failed"
}

stage_ship() {
    if ((!DO_SHIP)); then
        log "ship: disabled by --no-ship"
        return 0
    fi
    log "ship: $ZOT_ARTIFACTS/ → $SHIP_HOST:$SHIP_PATH"
    # mbp ships openrsync, not GNU rsync: --info=* and '***' patterns are
    # GNU extensions it rejects outright. Flags here must stay in the
    # portable subset (verified against openrsync protocol 29).
    run rsync -a --stats \
        --delete \
        --exclude 'staging' \
        --exclude 'quarantine' \
        --exclude '*.building' \
        -e 'ssh -o BatchMode=yes -o ConnectTimeout=20' \
        "$ZOT_ARTIFACTS/" "$SHIP_HOST:$SHIP_PATH" ||
        fail_stage ship "rsync to $SHIP_HOST failed"

    # Verify what landed. ~/.local/bin is NOT on the VM's non-interactive
    # ssh PATH, so the remote invocation exports it explicitly; without
    # that the check fails with "zot: command not found" and reads as a
    # broken deploy.
    ((DRY_RUN)) && {
        printf '    would verify: ssh %s zot status --json\n' "$SHIP_HOST"
        return 0
    }
    local remote local_snap remote_snap
    remote=$(ssh -o BatchMode=yes -o ConnectTimeout=20 "$SHIP_HOST" \
        'export PATH=$HOME/.local/bin:$PATH; zot status --json' 2>/dev/null) ||
        fail_stage ship "shipped, but the remote zot status did not answer"
    remote_snap=$(printf '%s' "$remote" | jq -r '.data.snapshot // empty')
    local_snap=$("$ZOT_BIN" status --json --db "$ZOT_ARTIFACTS/zot.duckdb" | jq -r '.data.snapshot // empty')
    if [[ -z $remote_snap || $remote_snap != "$local_snap" ]]; then
        fail_stage ship "remote snapshot is ${remote_snap:-unreadable}, local is $local_snap"
    fi
    log "ship: verified $SHIP_HOST serving $remote_snap"
    state_set --arg s "$remote_snap" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '.shipped = {snapshot:$s, host:"'"$SHIP_HOST"'", at:$at}'
}

# ---------------------------------------------------------------------------
# Slow cadence: acquire, extract, parse
# ---------------------------------------------------------------------------

stage_acquire_pdfs() {
    run mkdir -p "$PDF_INBOX"
    # --attach requires --download; the two are one operation, not two
    # flags. SCI_ASSUME answers the confirmation the write path prompts for.
    SCI_ASSUME=yes run "$SCI_BIN" zot --library "$PDF_LIBRARY" doctor pdfs \
        --saved-search "$PDF_SOURCE" --download "$PDF_INBOX" --attach --yes ||
        log "acquire: doctor pdfs returned nonzero — continuing (nothing downstream depends on it)"
}

stage_extract_docling() {
    SCI_ASSUME=yes run "$SCI_BIN" zot extract-lib --apply --yes --out "$EXTRACT_DIR" ||
        fail_stage extract-docling "sci zot extract-lib failed"
}

# The GROBID arm is a second DRIVER, not a second flag — it posts PDFs to a
# local JVM service. That service is not something an unattended runner may
# start on a host it is not allowed to reconfigure, so a service that is
# down SKIPS the arm and says how to start it. The docling arm and the
# whole fast path are unaffected; `is_primary` exists precisely because the
# corpus is read by both engines.
stage_extract_grobid() {
    if ! curl -fsS -m 5 "$GROBID_URL/api/isalive" >/dev/null 2>&1; then
        log "grobid: service at $GROBID_URL is down — skipping this arm"
        log "grobid: start it with  JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home ./gradlew run"
        state_set '.grobid = {status:"skipped", reason:"service_down", at:(now|todate)}'
        notify "zot pipeline: GROBID skipped" "service at $GROBID_URL is not running"
        return 0
    fi

    # The worklist is <parent key>\t<pdf path>, regenerated from the dump
    # that was just promoted so it names exactly the PDFs this library
    # holds. extract.py is resumable — a present <KEY>.tei.xml is skipped —
    # so handing it the full list only costs the new documents.
    local worklist="$STATE_DIR/grobid-worklist.tsv"
    local data_dir
    data_dir=$(zotero_data_dir)
    ((DRY_RUN)) || jq -r --arg d "$data_dir" '
        select(.kind=="item")
        | select(.type != "attachment" and .type != "note" and .type != "annotation")
        | . as $it
        | (.attachments // [])
        | map(select(.content_type == "application/pdf" and (.link_mode == 0 or .link_mode == 1)))
        | first
        | select(. != null)
        | [$it.key, ($d + "/storage/" + .key + "/" + .filename)]
        | @tsv' <"$ZOT_STAGING/zotero-items.ndjson" >"$worklist"

    run mkdir -p "$TEI_DIR"
    run "$GROBID_PILOT/extract.py" --worklist "$worklist" --outdir "$TEI_DIR" \
        --url "$GROBID_URL" --workers "$GROBID_WORKERS" ||
        log "grobid: extract.py returned nonzero — per-document failures are recorded in progress.jsonl"
}

stage_parse() {
    run "$ZOT_BIN" parse-tei --tei-dir "$TEI_DIR" --staging "$ZOT_STAGING" ||
        fail_stage parse-tei "zot parse-tei failed"
    run "$ZOT_BIN" parse-docling --extract-dir "$EXTRACT_DIR" --staging "$ZOT_STAGING" ||
        fail_stage parse-docling "zot parse-docling failed"
}

# ---------------------------------------------------------------------------
# Cadences
# ---------------------------------------------------------------------------

cadence_fast() {
    local versions want first_seen
    versions=$(state_get '.pending.versions' '')
    want=$(state_get '.pending.max_version' 0)
    first_seen=$(state_get '.pending.first_seen_epoch' 0)
    [[ -n $versions ]] || {
        versions=$(remote_versions || echo "")
        want=$(max_remote_version "$versions")
        first_seen=$(date +%s)
    }

    log "fast cadence: target versions=${versions:-unknown}"
    stage_export "$want" "$first_seen"
    stage_openalex
    stage_build
    stage_ship

    state_set --arg v "$versions" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '.seen = {versions:$v, at:$at} | del(.pending)'
    record_outcome ok "$VERB" "completed"
    log "fast cadence: done"
}

cadence_slow() {
    log "slow cadence: starting"
    if ((DO_EXTRACT)); then
        stage_acquire_pdfs
        stage_extract_docling
        stage_extract_grobid
    else
        log "extraction: disabled by --no-extract"
    fi
    stage_parse
    # Extraction writes child notes back into Zotero, so the item plane has
    # moved: re-export rather than build over a dump that predates our own
    # writes.
    local versions want
    versions=$(remote_versions || echo "")
    want=$(max_remote_version "$versions")
    stage_export "$want" "$(date +%s)"
    stage_openalex
    stage_build
    stage_ship
    state_set --arg v "$versions" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '.seen = {versions:$v, at:$at} | del(.pending)'
    record_outcome ok slow "completed"
    log "slow cadence: done"
}

# poll — the only entry point that decides whether to do anything at all.
cadence_poll() {
    local now versions last
    now=$(date +%s)
    versions=$(remote_versions) || {
        log "poll: could not read the Zotero counter — leaving state untouched"
        exit 0
    }
    last=$(state_get '.seen.versions' '')

    if [[ $versions == "$last" ]]; then
        log "poll: unchanged ($versions)"
        exit 0
    fi

    local pending
    pending=$(state_get '.pending.versions' '')
    if [[ $pending != "$versions" ]]; then
        log "poll: counter moved ${last:-<none>} → $versions"
        local first
        first=$(state_get '.pending.first_seen_epoch' "$now")
        [[ $first =~ ^[0-9]+$ ]] || first=$now
        state_set --arg v "$versions" --argjson lc "$now" --argjson fs "$first" \
            --argjson mv "$(max_remote_version "$versions")" \
            '.pending = {versions:$v, last_change_epoch:$lc, first_seen_epoch:$fs, max_version:$mv}'
        ((FORCE_ONCE)) || {
            log "poll: debouncing for ${DEBOUNCE_SECONDS}s of quiet"
            exit 0
        }
    fi

    local last_change
    last_change=$(state_get '.pending.last_change_epoch' "$now")
    if ((!FORCE_ONCE)) && ! pl_debounce_ready "$last_change" "$now" "$DEBOUNCE_SECONDS"; then
        log "poll: still settling ($((now - last_change))s < ${DEBOUNCE_SECONDS}s)"
        exit 0
    fi

    log "poll: quiet — firing the fast cadence for $versions"
    cadence_fast
}

# ---------------------------------------------------------------------------
# preflight / status
# ---------------------------------------------------------------------------

preflight() {
    local misses=0
    check() {
        local label=$1 ok=$2 detail=$3
        if [[ $ok == yes ]]; then
            printf '  ok    %-22s %s\n' "$label" "$detail"
        else
            printf '  MISS  %-22s %s\n' "$label" "$detail"
            misses=$((misses + 1))
        fi
    }

    printf 'zot-pipeline preflight on %s\n' "$(hostname -s)"
    check sci "$([[ -x ${SCI_BIN:-} ]] && echo yes || echo no)" "${SCI_BIN:-not found}"
    check zot "$([[ -x ${ZOT_BIN:-} ]] && echo yes || echo no)" "${ZOT_BIN:-not found on PATH or in the synced checkout}"
    for t in jq curl rsync osascript; do
        check "$t" "$(command -v "$t" >/dev/null && echo yes || echo no)" "$(command -v "$t" || echo 'not on PATH')"
    done
    check sci-config "$([[ -r $SCI_CONFIG ]] && echo yes || echo no)" "$SCI_CONFIG"

    local dd
    dd=$(zotero_data_dir)
    check zotero-data-dir "$([[ -n $dd && -r "$dd/zotero.sqlite" ]] && echo yes || echo no)" "${dd:-unset}"
    if [[ -n $dd && -r "$dd/zotero.sqlite" ]]; then
        local mode
        mode=$(od -An -tu1 -j18 -N1 "$dd/zotero.sqlite" | tr -d ' ')
        printf '  note  %-22s journal mode %s (%s)\n' "zotero.sqlite" "$mode" \
            "$([[ $mode == 2 ]] && echo 'WAL — the pending_wal_bytes gate is live' || echo 'rollback — the journal + sync gates carry the load')"
    fi

    check staging "$([[ -d $ZOT_STAGING ]] && echo yes || echo no)" "$ZOT_STAGING"
    for f in zotero-items openalex-works openalex-titles openalex-authors openalex-venues openalex-institutions; do
        check "staged:$f" "$([[ -r "$ZOT_STAGING/$f.ndjson" ]] && echo yes || echo no)" "$ZOT_STAGING/$f.ndjson"
    done
    check tei-dir "$([[ -d $TEI_DIR ]] && echo yes || echo no)" "$TEI_DIR"
    check extract-dir "$([[ -d $EXTRACT_DIR ]] && echo yes || echo no)" "$EXTRACT_DIR"
    check grobid-driver "$([[ -r "$GROBID_PILOT/extract.py" ]] && echo yes || echo no)" "$GROBID_PILOT/extract.py"
    printf '  note  %-22s %s\n' "grobid service" \
        "$(curl -fsS -m 5 "$GROBID_URL/api/isalive" >/dev/null 2>&1 && echo "up at $GROBID_URL" || echo "down at $GROBID_URL (the arm skips, the pipeline does not)")"

    local counters
    if counters=$(remote_versions); then
        check zotero-counter yes "$counters"
    else
        check zotero-counter no "the Zotero Web API did not answer"
    fi

    if ssh -o BatchMode=yes -o ConnectTimeout=15 "$SHIP_HOST" \
        'export PATH=$HOME/.local/bin:$PATH; zot --version' >/dev/null 2>&1; then
        check ship-target yes "$SHIP_HOST reachable, remote zot answers"
    else
        check ship-target no "$SHIP_HOST: ssh BatchMode failed, or remote zot is not on \$HOME/.local/bin"
    fi

    printf '\n%s\n' "$([[ $misses == 0 ]] && echo 'preflight: all prerequisites present' || echo "preflight: $misses missing prerequisite(s)")"
    return $((misses > 0))
}

show_status() {
    if [[ ! -r $STATE_FILE ]]; then
        printf 'zot-pipeline: no state yet (%s)\n' "$STATE_FILE"
        return 0
    fi
    if [[ -r $FAIL_MARKER ]]; then
        printf 'ALARM  %s' "$(cat "$FAIL_MARKER")"
    fi
    jq -r '
      "last run   \(.last_run.status // "?")  \(.last_run.cadence // "?")  \(.last_run.at // "?")",
      "           stage=\(.last_run.stage // "-")  reason=\(.last_run.reason // "-")",
      "counter    seen=\(.seen.versions // "-")  pending=\(.pending.versions // "-")",
      "last hold  \(.last_gate_hold.gate // "-"): \(.last_gate_hold.detail // "-")  at \(.last_gate_hold.at // "-")  consecutive=\(.consecutive_holds // 0)",
      "openalex   \(.openalex.decision // "-")  new_dois=\(.openalex.new_dois // 0) est=\(.openalex.estimated_requests // "-") cap=\(.openalex.cap // "-") deferrals=\(.openalex_deferrals // 0)",
      "shipped    \(.shipped.snapshot // "-") to \(.shipped.host // "-") at \(.shipped.at // "-")"
    ' <"$STATE_FILE"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

resolve_tools

# The runner owns its own log, rather than the plist owning it via
# StandardOutPath: launchd fails a job whose log DIRECTORY does not exist,
# and requiring a directory to be created by hand on the target host before
# the job can start is a prerequisite nobody remembers. Here the first run
# creates it.
if [[ $VERB != status && $VERB != preflight ]] && ((!DRY_RUN)); then
    mkdir -p "$LOG_DIR"
    exec > >(tee -a "$LOG_DIR/$VERB-$(date -u +%Y%m%d).log") 2>&1
fi

case $VERB in
status)
    show_status
    exit 0
    ;;
preflight)
    preflight
    exit $?
    ;;
esac

[[ -x ${SCI_BIN:-} ]] || die "sci not found — run 'zot-pipeline preflight'"
[[ -x ${ZOT_BIN:-} ]] || die "zot not found — run 'zot-pipeline preflight'"

# The last-resort recorder. An ERR trap cannot do this job: with -E it
# fires inside the command substitutions the gates are read through, where
# a deliberate "return 1" is indistinguishable from a crash, and without -E
# it never fires inside a function at all — which is where every stage
# lives. An EXIT trap sees exactly one thing: this process ended without
# any code path having recorded why. The $$ guard keeps it from firing in a
# forked subshell, and OUTCOME_RECORDED keeps it from overwriting a verdict
# some stage already reached.
on_exit() {
    local rc=$?
    # BASHPID is bash 4+; mbp runs Apple's bash 3.2, where `set -u` makes a
    # bare reference fatal — and fatal in the EXIT trap, which is the last
    # place an error can still be reported. The default keeps it a guard
    # rather than a landmine. It is belt-and-braces either way: bash does
    # not run an EXIT trap inside a command substitution (verified on 3.2
    # and 5.x), so the trap already cannot misfire where -E used to.
    [[ ${BASHPID:-$$} == "$$" ]] || return 0
    ((LOCK_HELD)) && rm -rf "$LOCK_DIR"
    ((rc == 0)) && return 0
    ((OUTCOME_RECORDED)) && return 0
    record_outcome failed "$VERB" "exited $rc without reaching a stage verdict"
    return 0
}
trap on_exit EXIT

case $VERB in
poll)
    acquire_lock
    cadence_poll
    ;;
fast)
    acquire_lock
    cadence_fast
    ;;
slow)
    acquire_lock
    cadence_slow
    ;;
esac
