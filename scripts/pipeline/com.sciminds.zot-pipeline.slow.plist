<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sciminds.zot-pipeline.slow</string>

  <!-- The extraction cadence: acquire PDFs, run docling and GROBID over
       what is new, re-parse both corpora, then the fast cadence's tail.
       Minutes per paper, so it runs once nightly rather than per item —
       and it takes the same lock the fast cadence does. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/esh/syncthing/air-mbp/sci/scripts/pipeline/zot-pipeline</string>
    <string>slow</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/esh/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/esh</string>

  <!-- docling holds ~14GB per process and GROBID drives a 20-way JVM.
       Neither should win a scheduling fight with whatever the machine is
       actually for. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
