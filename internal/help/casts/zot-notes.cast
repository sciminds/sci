[1.5, "o", "  \u001b[36mNOTE0002\u001b[m  \u001b[90mABC12345\u001b[m  Emergent Abilities of Large Language Models\r\n"]
[1.6, "o", "    \u001b[90mReading summary \u2014 the scaling claim is about discontinuity, not size\u001b[m\r\n"]
