[1.9, "o", "    \u001b[90mReading group wk 4: three papers converge on the same null result\u001b[m\r\n"]
[2.1, "o", "  \u001b[36mNOTE0014\u001b[m  \u001b[90mPQR11223\u001b[m  Resting-State Functional Connectivity\r\n"]
