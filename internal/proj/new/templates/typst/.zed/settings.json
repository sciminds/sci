{
  "languages": {
    "Typst": {
      // Wrap to the pane, not a column guide: these are prose documents.
      "soft_wrap": "editor_width"
    },
    "Markdown": {
      "soft_wrap": "editor_width"
    }
  },
  "lsp": {
    // Zed has no PDF viewer, so tinymist runs a persistent preview server
    // instead: open http://127.0.0.1:23635 once and leave it open — it
    // follows whichever .typ file is focused.
    "tinymist": {
      "initialization_options": {
        "preview": {
          "background": {
            "enabled": true,
            "args": ["--data-plane-host=127.0.0.1:23635", "--invert-colors=never"]
          }
        }
      },
      "settings": {
        "formatterMode": "typstyle"
      }
    }
  },
  "file_scan_exclusions": [".git", ".zed", "*.pdf"]
}
