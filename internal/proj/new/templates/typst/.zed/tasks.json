[
  {
    "label": "Typst: Live Preview (browser)",
    "command": "tinymist preview main.typ",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never",
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false
  },
  {
    "label": "Typst: Build PDF",
    "command": "typst compile --root . main.typ",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never",
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false,
    "show_summary": false
  },
  {
    "label": "Typst: Watch PDF",
    "command": "typst watch --root . main.typ",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never",
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false
  }
]
